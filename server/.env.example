# انسخ هذا الملف إلى .env على الخادم واملأ القيم الحقيقية.
# لا تضف ملف .env نفسه أبداً إلى Git (تأكد أنه مذكور في .gitignore).

# اتصال قاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname
# اجعلها false فقط لو تشغّل Postgres محلياً بدون SSL
DATABASE_SSL=true

# سر توقيع جلسات الدخول (JWT) — استخدم نصاً عشوائياً طويلاً وفريداً
JWT_SECRET=ASDASHDKJHASDKJHFASJDHFASDFASHDFKAHSFDJHASFDJASDASDSADASDASDASDASDSADASDASDASDHFSAJHK
# اختياري — استخدمه فقط أثناء تدوير JWT_SECRET (اضبطه على القيمة القديمة لحد ما تتأكد إن كل
# الجلسات القديمة انتهت أو سجّلت دخول من جديد بالمفتاح الجديد، ثم احذفه):
# JWT_SECRET_PREVIOUS=

# سر توليد/التحقق من أكواد ترخيص البرنامج — يجب أن يطابق تماماً القيمة
# المستخدمة في أداة توليد أكواد الترخيص الخاصة بك (المنفصلة عن هذا المستودع).
# ⚠️ ضع هنا قيمة عشوائية طويلة خاصة بك فقط — لا تستخدم أي قيمة سبق ذكرها
# في أي نسخة قديمة من هذا الملف أو من app-inline.js، فهي تُعتبر مكشوفة نهائياً.
LICENSE_SECRET=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_SECRET

# مفتاح تشفير بيانات اعتماد "فاتورة" (ZATCA) في قاعدة البيانات — 64 حرف hex (32 بايت).
# يشفّر المفتاح الخاص وكل أسرار الاعتماد مع الهيئة قبل تخزينها، منفصل تماماً عن أي
# سر آخر في هذا الملف. ولّد قيمة عشوائية جديدة بهذا الأمر ولا تشاركها مع أحد:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ احتفظ بنسخة احتياطية آمنة منها في مكان منفصل عن السيرفر: لو ضاعت، ستفقد القدرة
# على قراءة بيانات اعتماد الهيئة المخزّنة وستحتاج لإعادة التسجيل معها من الصفر.
ZATCA_ENC_KEY=REPLACE_WITH_YOUR_OWN_64_CHAR_HEX_KEY

# مفتاح Anthropic API (لقراءة فواتير الدورات بالذكاء الاصطناعي من صور/PDF)
ANTHROPIC_API_KEY=sk-ant-...

# حساب طوارئ ثابت (Break-glass) مستقل تماماً عن قاعدة البيانات — يستمر في العمل
# حتى لو تغيّرت قاعدة البيانات بالكامل أو أُفرغت أو تعطّل جدول المستخدمين. اختياري:
# لو سبته فارغاً يبقى هذا الحساب معطّلاً تلقائياً دون أي تأثير على باقي النظام.
# لا تضع هنا كلمة المرور الصريحة، بل الـ hash الخاص بها فقط. لتوليده شغّل من مجلد server:
#   node -e "require('bcryptjs').hash(process.argv[1], 12).then(h=>console.log(h))" "كلمة_المرور_هنا"
EMERGENCY_ADMIN_USERNAME=
EMERGENCY_ADMIN_PASSWORD_HASH=

# منفذ تشغيل الخادم (اختياري، افتراضي 3000)
PORT=3000

# إعدادات إرسال الإيميل (SMTP) — تُستخدم لـ: "الدخول عبر رابط بالإيميل" (Magic Link)،
# إرسال الفواتير للعملاء، إرسال التقارير، وتنبيهات الأمان للإدارة.
# اتركها فارغة تماماً لتعطيل كل ميزات الإيميل بأمان (باقي النظام يعمل بشكل طبيعي بدونها).
# مثال جاهز لحساب Gmail: SMTP_HOST=smtp.gmail.com و SMTP_PORT=587، وSMTP_USER هو عنوان
# الجيميل نفسه، وSMTP_PASS هو "App Password" (كلمة مرور تطبيق) تُولَّد من إعدادات أمان حساب
# جوجل (تتطلب تفعيل التحقق بخطوتين على الحساب أولاً) — وليس كلمة مرور الجيميل العادية نفسها.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# عنوان "المرسل" الظاهر فى الإيميل (اختياري، افتراضياً نفس SMTP_USER):
SMTP_FROM=

# إيميلات الإدارة التي تستقبل تنبيهات النظام تلقائياً (دخول مشبوه، جهاز جديد، محاولات
# دخول فاشلة متكررة، فشل إرسال فاتورة لهيئة الزكاة) — مفصولة بفواصل. اتركها فارغة لتعطيل
# هذه التنبيهات فقط (باقي ميزات الإيميل — الفواتير والتقارير — تعمل بشكل مستقل عنها).
ADMIN_ALERT_EMAILS=

# الأصول (origins) المسموح لها بمناداة الـ API من متصفح مختلف عن دومين الخادم نفسه،
# مفصولة بفواصل (مثال: https://app.example.com,https://admin.example.com).
# اتركه فارغاً إن كانت الواجهة تُخدَّم دائماً من نفس دومين هذا الخادم (الوضع الافتراضي والموصى به).
CORS_ORIGIN=
